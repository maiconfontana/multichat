{
  "name": "multichat",
  "desktopName": "multichat",
  "version": "1.5.0",
  "description": "MultiChat — Multi-account messenger desktop app",
  "author": "Diego Aguirre (DagMoller) — local fork",
  "license": "MIT",
  "keywords": ["multichat", "electron", "multi-account", "messenger"],
  "main": "./src/main.js",
  "scripts": {
    "start": "electron .",
    "icons": "electron scripts/gen-icon.js",
    "clean": "rm -rf ./dist",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux --x64",
    "dist:windows": "electron-builder --windows --x64",
    "dist:mac": "electron-builder --mac --arm64 --x64"
  },
  "build": {
    "appId": "com.maiconfontana.multichat",
    "productName": "MultiChat",
    "files": [
      "src/**/*",
      "assets/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "Network",
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "tar.xz", "arch": ["x64"] }
      ]
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": ["nsis", "zip"],
      "signExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "MultiChat-${version}-setup.${ext}"
    },
    "mac": {
      "icon": "assets/icon.png",
      "category": "public.app-category.social-networking",
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ]
    },
    "protocols": [
      {
        "name": "WhatsApp",
        "schemes": ["whatsapp"]
      }
    ]
  },
  "dependencies": {
    "electron-store": "^11.0.2"
  },
  "devDependencies": {
    "electron": "^42.9.3",
    "electron-builder": "^26.15.7"
  }
}
