{
  "name": "multichat",
  "desktopName": "multichat",
  "version": "1.4.0",
  "description": "MultiChat — Multi-account messenger desktop app",
  "author": "Diego Aguirre (DagMoller) — local fork",
  "license": "MIT",
  "keywords": ["multichat", "electron", "multi-account", "messenger"],
  "main": "./src/main.js",
  "scripts": {
    "start": "electron .",
    "clean": "rm -rf ./dist",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux --x64",
    "dist:windows": "electron-builder --windows --x64"
  },
  "build": {
    "appId": "com.maiconfontana.multichat",
    "productName": "MultiChat",
    "files": [
      "src/**/*",
      "assets/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "Network",
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "tar.xz", "arch": ["x64"] }
      ],
      "asarUnpack": [
        "**/assets/*.svg",
        "**/assets/*.png"
      ]
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": ["portable", "zip"],
      "signExecutable": false,
      "asarUnpack": [
        "**/assets/*.svg",
        "**/assets/*.png"
      ]
    },
    "protocols": [
      {
        "name": "WhatsApp",
        "schemes": ["whatsapp"]
      }
    ]
  },
  "dependencies": {
    "electron-store": "^11.0.2"
  },
  "devDependencies": {
    "electron": "^42.9.3",
    "electron-builder": "^26.15.7"
  }
}
