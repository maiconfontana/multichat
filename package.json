{
  "name": "whatsapp-electron",
  "desktopName": "com.github.dagmoller.whatsapp-electron",
  "version": "1.2.10",
  "description": "DagMoller's WhatsApp Electron Multi-Account App",
  "author": "Diego Aguirre (DagMoller)",
  "license": "ISC",
  "keywords": [
    "whatsapp",
    "electron",
    "multi-account"
  ],
  "main": "./src/main.js",
  "scripts": {
    "start": "electron .",
    "clean": "rm -rf ./dist",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux --x64",
    "dist:windows": "electron-builder --windows --x64"
  },
  "build": {
    "linux": {
      "appId": "WhatsApp Electron",
      "icon": "./src/assets/whatsapp-icon-512x512.png",
      "category": "Network",
      "target": [
        "AppImage",
        "tar.xz"
      ],
      "asarUnpack": [
        "**/assets/*.svg",
        "**/assets/*.png"
      ]
    },
    "win": {
      "appId": "WhatsApp Electron",
      "icon": "./src/assets/whatsapp-icon-512x512.png",
      "target": [
        "portable",
        "zip"
      ],
      "signExecutable": false,
      "asarUnpack": [
        "**/assets/*.svg",
        "**/assets/*.png"
      ]
    },
    "protocols": [
      {
        "name": "WhatsApp",
        "schemes": [
          "whatsapp"
        ]
      }
    ]
  },
  "dependencies": {
    "electron-store": "^11.0.2"
  },
  "devDependencies": {
    "electron": "^42.9.3",
    "electron-builder": "^26.15.7"
  }
}
